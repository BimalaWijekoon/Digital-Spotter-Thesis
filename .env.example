# Digital Spotter — Raspberry Pi Environment Variables
#
# HOW TO USE:
#   1. Copy this file to .env  (cp .env.example .env)
#   2. Fill in your real values
#   3. .env is in .gitignore — it will never be committed to git
#
# Then either:
#   a) Load manually before running: source .env && python3 scripts/...
#   b) Or use python-dotenv (pip install python-dotenv) — already integrated
#
# This file contains placeholders only. Never put working credentials here.

# ─── HiveMQ Cloud ─────────────────────────────────────────────────────────────
DS_MQTT_BROKER=mqtt.example.invalid
DS_MQTT_PORT=8883
DS_MQTT_USERNAME=replace_me
DS_MQTT_PASSWORD=replace_me
DS_MQTT_ENABLED=false

# ─── GPIO Hardware ────────────────────────────────────────────────────────────
DS_BUZZER_PIN=18
DS_BUZZER_ENABLED=true
DS_BUZZER_FREQ=2500

DS_RGB_PIN_R=27
DS_RGB_PIN_G=17
DS_RGB_PIN_B=22
DS_RGB_ENABLED=true
DS_RGB_COMMON_ANODE=false

# ─── Inference ────────────────────────────────────────────────────────────────
DS_LOG_LEVEL=INFO
