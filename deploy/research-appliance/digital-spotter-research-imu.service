[Unit]
Description=Digital Spotter research BLE wearable owner
After=digital-spotter-research-core.service
Requires=digital-spotter-research-core.service
PartOf=digital-spotter-research.target

[Service]
Type=simple
EnvironmentFile=%h/.config/digital-spotter-research/appliance.env
WorkingDirectory=%h/digital-spotter-research/current
ExecStart=/bin/sh %h/digital-spotter-research/current/deploy/research-appliance/run-imu.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=12
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=digital-spotter-research.target
